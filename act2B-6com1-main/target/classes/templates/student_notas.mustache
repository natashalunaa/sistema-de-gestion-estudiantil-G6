<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis notas</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <main class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Mis notas</h1>
                <p class="text-sm text-gray-500 mt-1">Alumno: {{dniAlumno}}</p>
            </div>
            <a href="/dashboard/student"
               class="inline-block bg-slate-600 text-white py-2 px-4 rounded-xl hover:bg-slate-700 text-center font-semibold">
                Volver al panel
            </a>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-xl mb-6 text-center">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-xl mb-6 text-center">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        {{#notas}}
        <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Materia</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Fecha</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Nota</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {{#notas}}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-800">{{nombre_materia}}</td>
                        <td class="px-6 py-4 text-sm text-gray-800">{{fecha}}</td>
                        <td class="px-6 py-4 text-sm text-gray-800">{{nota}}</td>
                    </tr>
                    {{/notas}}
                </tbody>
            </table>
        </div>
        {{/notas}}

        {{^notas}}
        <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center">
            Todavía no estás anotado en ningún examen.
        </div>
        {{/notas}}
    </main>
</body>
</html>