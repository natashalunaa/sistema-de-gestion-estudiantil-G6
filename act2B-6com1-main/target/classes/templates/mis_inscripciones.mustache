<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis inscripciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <main class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Mis inscripciones</h1>
                <p class="text-sm text-gray-500 mt-1">Materias que estas cursando actualmente.</p>
            </div>

            <a href="/dashboard/student"
               class="inline-block bg-slate-600 text-white py-2 px-4 rounded-xl hover:bg-slate-700 text-center font-semibold">
                Volver al panel
            </a>
        </div>

        {{#materiasInscripto}}
        <div class="flex flex-col gap-3 border-t border-gray-200 py-5 first:border-t-0 first:pt-0 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="font-semibold text-gray-900">{{nombre_materia}}</p>
                <p class="text-sm text-gray-500">{{cod_materia}} | Anio {{anio_materia}}</p>
            </div>

            <span class="inline-block self-start rounded-lg bg-slate-200 px-3 py-1 text-sm font-semibold text-slate-700 sm:self-auto">
                {{condicion_final}}
            </span>
        </div>
        {{/materiasInscripto}}

        {{^materiasInscripto}}
        <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center">
            Todavia no estas inscripto en ninguna materia.
        </div>
        {{/materiasInscripto}}

        <div class="mt-8">
            <a href="/student/inscripciones"
               class="inline-block bg-blue-600 text-white py-3 px-6 rounded-xl hover:bg-blue-700 text-center font-semibold">
                Inscribirme a una materia
            </a>
        </div>
    </main>
</body>
</html>
