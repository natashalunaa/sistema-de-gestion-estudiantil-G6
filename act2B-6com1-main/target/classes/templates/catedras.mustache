<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Cátedras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen p-4">

<div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">

    <!-- Título -->
    <h1 class="text-3xl font-bold text-center mb-8">
        Gestión de Cátedras
    </h1>

    <!-- Mensajes -->
    {{#successMessage}}
    <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-lg mb-6">
        {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-lg mb-6">
        {{errorMessage}}
    </div>
    {{/errorMessage}}

    <!-- Formulario -->

    <form action="/admin/catedras/asignar" method="post" class="grid grid-cols-3 gap-4 items-end mb-8">

        <!-- Docentes -->
        <div>

            <label class="block text-sm font-medium text-gray-700 mb-2">
                Docente
            </label>

            <select
                    name="docente_dni"
                    required
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">

                {{#docentes}}

                <option value="{{dni}}">
                    {{dni}}
                </option>

                {{/docentes}}

            </select>

        </div>


        <!-- Materias -->
        <div>

            <label class="block text-sm font-medium text-gray-700 mb-2">
                Materia
            </label>

            <select
                    name="cod_materia"
                    required
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">

                {{#materias}}

                <option value="{{codMateria}}">
                    {{nombreMateria}}
                </option>

                {{/materias}}

            </select>

        </div>


        <!-- Botón -->
        <div>

            <button
                    type="submit"
                    class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700">

                Asignar

            </button>

        </div>

    </form>

    <!-- Tabla -->

    <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">

        <table class="min-w-full divide-y divide-gray-200">

            <thead class="bg-slate-50">

            <tr>

                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                    Docente
                </th>

                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                    Materia
                </th>

                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                    Acciones
                </th>

            </tr>

            </thead>

            <tbody class="bg-white divide-y divide-gray-200">

            {{#catedras}}

            <tr>

                <td class="px-6 py-4 text-sm text-gray-800">
                    {{docente_dni}}
                </td>

                <td class="px-6 py-4 text-sm text-gray-800">
                    {{cod_materia}}
                </td>

                <td class="px-6 py-4 text-sm">

                    <form action="/admin/catedras/desasignar"
                          method="post"
                          onsubmit="return confirm('¿Desea eliminar esta asignación?')">

                        <input type="hidden"
                               name="docente_dni"
                               value="{{docente_dni}}">

                        <input type="hidden"
                               name="cod_materia"
                               value="{{cod_materia}}">

                        <button
                                type="submit"
                                class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded">

                            Eliminar

                        </button>
                    </form>
                </td>
            </tr>

            {{/catedras}}
            </tbody>
        </table>
    </div>

    <!-- Si no hay asignaciones -->

    {{^catedras}}

    <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center mt-4">
        No hay cátedras asignadas.
    </div>

    {{/catedras}}

    <!-- Botón volver -->

    <div class="mt-8">

        <a href="/dashboard/admin"
           class="inline-block bg-slate-600 text-white py-3 px-6 rounded-xl hover:bg-slate-700">

            Volver al panel
        </a>
    </div>
</div>

</body>

</html>