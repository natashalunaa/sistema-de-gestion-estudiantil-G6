<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Sistema de Gestión Estudiantil</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-10 rounded-3xl shadow-xl w-full max-w-lg">

        <!-- Logo -->

        <div class="text-center mb-4">
            <div class="text-6xl">
                🎓
            </div>
        </div>

        <!-- Título -->

        <h1 class="text-3xl font-bold text-center text-gray-800">
            Sistema de Gestión Estudiantil
        </h1>

        <p class="text-center text-gray-500 text-sm mt-2 mb-8">
            Inicia sesión para acceder a tu cuenta
        </p>

        <!-- Error -->

        {{#errorMessage}}
        <p class= "text-red-500 text-sm text-center mb-5">
            {{errorMessage}}
        </p>
        {{/errorMessage}}

        
        <!-- Éxito -->

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-xl mb-6 text-center">
            {{successMessage}}
        </div>
        {{/successMessage}}

        <!-- Formulario -->

        <form action="/login" method="post" class="space-y-5">

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    👤 Usuario
                </label>

                <input
                    type="text"
                    name="username"
                    required
                    placeholder="Ingrese su usuario"
                    class="w-full px-5 py-3 border border-gray-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">

            </div>

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    🔒 Contraseña
                </label>

                <input
                    type="password"
                    name="password"
                    required
                    placeholder="Ingrese su contraseña"
                    class="w-full px-5 py-3 border border-gray-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">

            </div>

            <button
                type="submit"
                class="w-full bg-blue-600 text-white py-3 rounded-xl hover:bg-blue-700 transition font-semibold text-lg">

                Iniciar sesión

            </button>

        </form>

        <!-- Crear cuenta -->

        <div class="mt-8 text-center">

            <p class="text-gray-500">
                ¿No tienes una cuenta?
            </p>

            <a
                href="/user/create"
                class="text-blue-600 font-semibold hover:underline">

                Crear una cuenta

            </a>

        </div>

    </div>

</body>

</html>