<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Carreras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <h1 class="text-3xl font-bold text-center mb-6">Listado de Carreras</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-lg mb-6">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-lg mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        {{#carreras.size}}
        <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Código</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Nombre de la Carrera</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Duración</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {{#carreras}}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-800">{{cod_carrera}}</td>
                        <td class="px-6 py-4 text-sm text-gray-800">{{nombre_carrera}}</td>
                        <td class="px-6 py-4 text-sm text-gray-800">{{duracion}} años</td>
                        <td class="px-6 py-4 text-sm text-gray-800">
                            <div class="flex gap-2">
                                <a href="/admin/carrera/edit/{{cod_carrera}}"
                                   class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm font-medium">
                                    Editar
                                </a>
                                
                                <a href="/admin/carrera/delete/{{cod_carrera}}" 
                                   onclick="return confirm('¿Está seguro que desea eliminar esta carrera?')"
                                   class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm font-medium">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                    {{/carreras}}
                </tbody>
            </table>
        </div>
        {{/carreras.size}}

        {{^carreras.size}}
        <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center mt-4">
            No hay carreras registradas todavía.
        </div>
        {{/carreras.size}}

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-between">
            <a href="/dashboard/admin"
               class="inline-block bg-slate-600 text-white py-3 px-6 rounded-xl hover:bg-slate-700 text-center font-medium">
                Volver al panel
            </a>
            <a href="/admin/carrera/new"
               class="inline-block bg-blue-600 text-white py-3 px-6 rounded-xl hover:bg-blue-700 text-center font-medium">
                Registrar carrera
            </a>
        </div>
    </div>
</body>
</html>