<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscripcion a materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <main class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Inscripcion a materias</h1>
                <p class="text-sm text-gray-500 mt-1">Alumno: {{dniAlumno}}</p>
            </div>

            <a href="/dashboard/student"
               class="inline-block bg-slate-600 text-white py-2 px-4 rounded-xl hover:bg-slate-700 text-center font-semibold">
                Volver al panel
            </a>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-xl mb-6">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-xl mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <section>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Materias disponibles</h2>

            {{#materias}}
            <div class="flex flex-col gap-4 border-t border-gray-200 py-5 first:border-t-0 first:pt-0 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="font-semibold text-gray-900">{{nombreMateria}}</p>
                    <p class="text-sm text-gray-500">{{codMateria}} | Año {{anioMateria}}</p>
                </div>

                <form action="/student/inscripciones/inscribir/{{codMateria}}" method="post"
                      class="flex flex-col gap-2 sm:flex-row sm:items-end">
                    <div>
                        <label for="cod_inscripcion_{{codMateria}}" class="block text-sm font-semibold text-gray-700 mb-1">
                            Codigo de inscripcion
                        </label>
                        <input type="text"
                               id="cod_inscripcion_{{codMateria}}"
                               name="cod_inscripcion"
                               required
                               autocomplete="off"
                               placeholder="Ingrese el codigo"
                               class="w-full px-4 py-2 border border-gray-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <button type="submit"
                            class="w-full bg-blue-600 text-white py-2 px-5 rounded-xl hover:bg-blue-700 font-semibold sm:w-auto">
                        Inscribirme
                    </button>
                </form>
            </div>
            {{/materias}}

            {{^materias}}
            <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center">
                No hay materias disponibles para inscripcion.
            </div>
            {{/materias}}
        </section>
    </main>
</body>
</html>
