<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Administrador - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <h1 class="text-4xl font-bold text-center mb-6">Panel de administrador</h1>

        {{#username}}
        <p class="text-center text-gray-700 mb-8">
            Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span>.
        </p>
        {{/username}}

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-lg mb-6">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-lg mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="grid gap-4 sm:grid-cols-2">
            <a href="/teacher/new"
               class="block bg-blue-600 text-white rounded-xl py-4 px-6 text-center hover:bg-blue-700">
                Registrar docente
            </a>
            <a href="/student/new"
               class="block bg-green-600 text-white rounded-xl py-4 px-6 text-center hover:bg-green-700">
                Registrar alumno
            </a>
            <a href="/teachers"
               class="block bg-yellow-600 text-white rounded-xl py-4 px-6 text-center hover:bg-yellow-700">
                Ver docentes
            </a>
            <a href="/students"
               class="block bg-purple-600 text-white rounded-xl py-4 px-6 text-center hover:bg-purple-700">
                Ver alumnos
            </a>
        </div>

        <div class="mt-10 text-center">
            <a href="/logout"
               class="inline-block bg-red-600 text-white py-3 px-8 rounded-full hover:bg-red-700">
                Cerrar sesión
            </a>
        </div>
    </div>
</body>
</html>