<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Estudiante - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <h1 class="text-4xl font-bold text-center mb-6">Panel de estudiante</h1>

        {{#username}}
        <p class="text-center text-gray-700 mb-8">
            Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span>.
        </p>
        {{/username}}

        <div class="space-y-4">
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-2">Tu cuenta</h2>
                <p class="text-gray-600">Accede a tu información y sigue tus materias.</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-2">Estado</h2>
                <p class="text-gray-600">Este panel es el espacio de inicio para estudiantes.</p>
            </div>
        </div>

        <div class="mt-10 text-center">
            <a href="/logout"
               class="inline-block bg-red-600 text-white py-3 px-8 rounded-full hover:bg-red-700">
                Cerrar sesión
            </a>
        </div>
    </div>
</body>
</html>