<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exámenes disponibles</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <main class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Exámenes disponibles</h1>
                <p class="text-sm text-gray-500 mt-1">Alumno: {{dniAlumno}}</p>
            </div>
            <div class="flex flex-col gap-2 sm:flex-row">
                <a href="/dashboard/student"
                   class="inline-block bg-slate-600 text-white py-2 px-4 rounded-xl hover:bg-slate-700 text-center font-semibold">
                    Volver al panel
                </a>
                <a href="/student/notas"
                   class="inline-block bg-emerald-600 text-white py-2 px-4 rounded-xl hover:bg-emerald-700 text-center font-semibold">
                    Mis notas
                </a>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-xl mb-6 text-center">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-xl mb-6 text-center">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        {{#examenes}}
        <div class="space-y-4">
            {{#examenes}}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-gray-200 py-4 first:border-t-0">
                <div>
                    <p class="font-semibold text-gray-900">{{nombre_materia}}</p>
                    <p class="text-sm text-gray-500">{{cod_materia}} | {{fecha}}</p>
                </div>
                <form action="/student/examenes/inscribir/{{id_examen}}" method="post">
                    <button type="submit"
                            class="bg-blue-600 text-white py-2 px-5 rounded-xl hover:bg-blue-700 font-semibold">
                        Inscribirme
                    </button>
                </form>
            </div>
            {{/examenes}}
        </div>
        {{/examenes}}

        {{^examenes}}
        <div class="bg-yellow-50 border border-yellow-300 text-yellow-700 p-6 rounded-2xl text-center">
            No hay exámenes disponibles para tus materias.
        </div>
        {{/examenes}}
    </main>
</body>
</html>