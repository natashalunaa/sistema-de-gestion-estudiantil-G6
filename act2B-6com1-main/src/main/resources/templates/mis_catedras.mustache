<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis cátedras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <h1 class="text-3xl font-bold text-center mb-6">Mis cátedras</h1>

        <div class="space-y-4">
            {{#materias}}
            <div class="border border-slate-200 rounded-2xl p-6">
                <p class="font-semibold text-gray-800">{{nombre_materia}}</p>
                <p class="text-sm text-gray-500">Código: {{cod_materia}}</p>
            </div>
            {{/materias}}

            {{^materias}}
            <div class="text-center text-gray-600">
                No estás asignado a ninguna cátedra por el momento.
            </div>
            {{/materias}}
        </div>

        <div class="mt-8 text-center">
            <a href="/dashboard/teacher"
               class="inline-block bg-blue-600 text-white py-3 px-8 rounded-full hover:bg-blue-700">
                Volver al panel
            </a>
        </div>
    </div>
</body>
</html>