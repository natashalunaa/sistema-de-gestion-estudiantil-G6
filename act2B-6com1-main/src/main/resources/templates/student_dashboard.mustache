<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estudiante - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        <h1 class="text-4xl font-bold text-center mb-6">Panel de estudiante</h1>

        {{#username}}
        <p class="text-center text-gray-700 mb-8">
            Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span>.
        </p>
        {{/username}}

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 p-4 rounded-xl mb-6 text-center">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-xl mb-6 text-center">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="space-y-4">
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-2">Tu cuenta</h2>
                <p class="text-gray-600">Accede a tu información, revisa tus materias y sigue tus exámenes.</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-4">Acciones</h2>
                <div class="grid gap-3 sm:grid-cols-2">
                    <a href="/student/inscripciones"
                       class="inline-block bg-blue-600 text-white py-3 px-4 rounded-xl hover:bg-blue-700 text-center font-semibold">
                        Inscribirme
                    </a>
                    <a href="/student/inscripciones/mis-inscripciones"
                       class="inline-block bg-emerald-600 text-white py-3 px-4 rounded-xl hover:bg-emerald-700 text-center font-semibold">
                        Mis inscripciones
                    </a>
                    <a href="/student/examenes"
                       class="inline-block bg-indigo-600 text-white py-3 px-4 rounded-xl hover:bg-indigo-700 text-center font-semibold">
                        Ver exámenes
                    </a>
                    <a href="/student/notas"
                       class="inline-block bg-emerald-700 text-white py-3 px-4 rounded-xl hover:bg-emerald-800 text-center font-semibold">
                        Mis notas
                    </a>
                </div>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-4">Materias que estoy cursando</h2>

                {{#materiasCursando}}
                <div class="flex flex-col gap-2 border-t border-slate-200 py-4 first:border-t-0 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="font-semibold text-gray-800">{{nombre_materia}}</p>
                        <p class="text-sm text-gray-500">{{cod_materia}} | Año {{anio_materia}}</p>
                    </div>
                    <span class="inline-block rounded-lg bg-slate-200 px-3 py-1 text-sm font-semibold text-slate-700">
                        {{condicion_final}}
                    </span>
                </div>
                {{/materiasCursando}}

                {{^materiasCursando}}
                <p class="text-gray-600">Todavía no estás cursando ninguna materia.</p>
                {{/materiasCursando}}
            </div>
        </div>

        <div class="mt-10 text-center">
            <a href="/logout"
               class="inline-block bg-red-600 text-white py-3 px-8 rounded-full hover:bg-red-700">
                Cerrar sesión
            </a>
        </div>
    </div>
</body>
</html>