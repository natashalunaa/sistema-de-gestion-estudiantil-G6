<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Carreras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6 min-h-screen">
    <div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-xl p-8">
        
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Carreras Registradas</h1>
            <a href="/admin/carrera/new" class="bg-rose-600 text-white px-4 py-2 rounded-xl font-medium hover:bg-rose-700 transition">
                + Nueva Carrera
            </a>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200">
            <table class="w-full text-left border-collapse bg-white">
                <thead class="bg-gray-50 text-gray-700 uppercase text-sm font-semibold">
                    <tr>
                        <th class="px-6 py-4">Código</th>
                        <th class="px-6 py-4">Nombre de la Carrera</th>
                        <th class="px-6 py-4 text-center">Duración (Años)</th>
                        <th class="px-6 py-4 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 text-gray-600">
                    
                    {{#carreras}}
                    <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-medium text-gray-900">{{cod_carrera}}</td>
                    <td class="px-6 py-4">{{nombre_carrera}}</td>
                    <td class="px-6 py-4 text-center">{{duracion}}</td>
                    <td class="px-6 py-4 text-center space-x-2">
                        <a href="/admin/carrera/edit/{{cod_carrera}}" class="text-blue-600 hover:text-blue-900 font-medium bg-blue-50 px-3 py-1 rounded-lg">
                            Editar
                        </a>
                        <form action="/admin/carrera/delete/{{cod_carrera}}" method="POST" class="inline">
                            <button type="submit" class="text-rose-600 hover:text-rose-900 font-medium bg-rose-50 px-3 py-1 rounded-lg" onclick="return confirm('¿Estás seguro de eliminar esta carrera?')">
                                Eliminar
                            </button>
                        </form>
                    </td>
                    </tr>
                    {{/carreras}}

                    {{^carreras}}
                    <tr>
                        <td colspan="3" class="px-6 py-10 text-center text-gray-400">
                            No hay carreras registradas en el sistema todavía.
                        </td>
                    </tr>
                    {{/carreras}}
                    
                </tbody>
            </table>
        </div>

        <div class="mt-8 text-center">
            <a href="/dashboard/admin" class="text-gray-500 hover:underline text-sm font-medium">
                Volver al panel de administración
            </a>
        </div>
    </div>
</body>
</html>