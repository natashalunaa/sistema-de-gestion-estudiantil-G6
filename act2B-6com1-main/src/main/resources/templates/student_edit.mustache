<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar alumno</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-3xl shadow-xl w-full max-w-lg">
        <h1 class="text-3xl font-bold text-center mb-6">Modificar alumno</h1>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded-lg mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <form action="/student/edit/{{dni}}" method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">DNI</label>
                <input type="text" name="dni" value="{{dni}}" readonly
                       class="w-full px-4 py-2 border rounded-lg bg-slate-100 cursor-not-allowed">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Nombre</label>
                <input type="text" name="nombre" value="{{nombre}}" required
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Apellido</label>
                <input type="text" name="apellido" value="{{apellido}}" required
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Correo electrónico</label>
                <input type="email" name="mail" value="{{mail}}" required
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Tipo de alumno</label>
                <select name="tipo_alumno" required
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Seleccione...</option>
                    <option value="Ingresante" {{#ingresanteSelected}}selected{{/ingresanteSelected}}>Ingresante</option>
                    <option value="Avanzado" {{#avanzadoSelected}}selected{{/avanzadoSelected}}>Avanzado</option>
                </select>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-3 rounded-xl hover:bg-blue-700">
                Guardar cambios
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/students" class="text-blue-600 hover:underline">Volver al listado</a>
        </div>
    </div>
</body>
</html>